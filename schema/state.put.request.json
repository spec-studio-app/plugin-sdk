{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-studio-app.github.io/plugin-sdk/schema/state.put.request.json",
  "title": "state.put params",
  "type": "object",
  "required": [
    "collection",
    "key",
    "value",
    "expectedVersion"
  ],
  "properties": {
    "collection": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "value": {},
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "expectedVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
