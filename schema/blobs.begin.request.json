{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-studio-app.github.io/plugin-sdk/schema/blobs.begin.request.json",
  "title": "blobs.begin params",
  "type": "object",
  "required": [
    "sha256",
    "size"
  ],
  "properties": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    }
  }
}
