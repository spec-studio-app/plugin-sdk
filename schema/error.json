{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-studio-app.github.io/plugin-sdk/schema/error.json",
  "title": "error",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "enum": [
            "not_found",
            "conflict",
            "closing",
            "dropped",
            "refused",
            "unavailable",
            "bad_settings"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
