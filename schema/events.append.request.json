{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-studio-app.github.io/plugin-sdk/schema/events.append.request.json",
  "title": "events.append params",
  "type": "object",
  "required": [
    "stream",
    "events"
  ],
  "properties": {
    "stream": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "data"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "data": {},
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
