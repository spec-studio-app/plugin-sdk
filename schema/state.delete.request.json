{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-studio-app.github.io/plugin-sdk/schema/state.delete.request.json",
  "title": "state.delete params",
  "type": "object",
  "required": [
    "collection",
    "key",
    "expectedVersion"
  ],
  "properties": {
    "collection": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$",
      "not": {
        "pattern": "\\.\\."
      }
    },
    "expectedVersion": {
      "type": "string",
      "minLength": 1
    }
  }
}
