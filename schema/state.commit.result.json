{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-studio-app.github.io/plugin-sdk/schema/state.commit.result.json",
  "title": "state.commit result",
  "type": "object",
  "required": [
    "version",
    "updatedAt",
    "cursors"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cursors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
